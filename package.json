{
  "name": "kova",
  "version": "0.1.0",
  "private": true,
  "description": "Kova — non-custodial automatic dollar-savings for the gig economy, built on Stellar.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-env.mjs && next build",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "db:migrate": "node scripts/db-migrate.mjs",
    "indexer": "node scripts/indexer.mjs",
    "e2e:testnet": "node scripts/e2e-testnet.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "^5.0.20",
    "@fontsource/archivo": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.1.0",
    "@gsap/react": "^2.1.1",
    "@stellar/stellar-sdk": "^14.2.0",
    "gsap": "^3.12.5",
    "next": "^14.2.33",
    "passkey-kit": "^0.12.0",
    "postgres": "^3.4.5",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "optionalDependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
