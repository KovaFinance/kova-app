# Kova environment — copy to `.env.local` and fill the blanks.
#
# This is a PRODUCTION-ONLY build (no demo mode). `npm run build` fails closed if
# any var marked [REQUIRED] below is missing. `npm run dev` only warns, so you can
# develop with these blank and fill them before building/deploying.
#
# All NEXT_PUBLIC_* values are inlined into the client bundle at build time — never
# put a secret in a NEXT_PUBLIC_ var. Server-only secrets go at the bottom.

# ---- Stellar network (testnet defaults — already filled) ----
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org          # [REQUIRED]
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org      # [REQUIRED]
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015 # [REQUIRED]

# ---- Deployed contracts / assets ----
# [REQUIRED] Vault contract id. Deploy with:
#   stellar keys generate kova-deployer --network testnet --fund
#   TOKEN=<USDC SAC> npm run deploy:testnet   # prints the deployed C... id
NEXT_PUBLIC_VAULT_CONTRACT_ID=
# [REQUIRED] USDC Stellar Asset Contract (SAC) address (the TOKEN above). Derive with:
#   stellar contract id asset --asset USDC:<ISSUER_G...> --network testnet
# Canonical Circle testnet USDC issuer: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_USDC_SAC=
# [REQUIRED] Yield venue the vault routes savings into. Deployed by `npm run deploy:testnet`
# (TEST-ONLY mock venue on testnet; real Blend/T-bill adapter on mainnet — see DECISIONS.md).
NEXT_PUBLIC_VENUE_CONTRACT_ID=
# Static FALLBACK rate (decimal), shown only if the live venue rate read fails (~0.045).
NEXT_PUBLIC_YIELD_RATE=0.045
# Staged-rollout / incident kill switch. "true" disables money actions + shows a banner.
NEXT_PUBLIC_KILL_SWITCH=false

# ---- SEP-24 cash in/out anchor (Phase 5) ----
# Testnet reference anchor for cash in/out. Endpoints + signing key are discovered from its
# stellar.toml at runtime. Default = SDF testnet anchor (test asset SRT; no real KYB). Swap to
# a regulated anchor on mainnet. SEP-10 auth works for classic (G…) accounts; passkey (C…)
# wallets need SEP-45 (gated in the UI).
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=testanchor.stellar.org
NEXT_PUBLIC_ANCHOR_ASSET_CODE=SRT

# ---- Passkey smart wallets ----
# [REQUIRED] wasm hash of the deployed passkey-kit smart-wallet contract the relayer
# deploys wallets from. Public. (WebAuthn RPID must match the HTTPS domain you serve from.)
NEXT_PUBLIC_WALLET_WASM_HASH=

# ---- Indexer (OPTIONAL / deferred) ----
# DECISION: Kova resolves passkey keyId -> wallet contract from its OWN backend
# (Phase 7), so a third-party indexer is NOT required. Mercury is kept here only as
# an optional alternative we may revisit. Leave blank.
NEXT_PUBLIC_MERCURY_URL=https://api.mercurydata.app
NEXT_PUBLIC_MERCURY_JWT=

# ---- Wallet connect (optional, for "connect existing wallet") ----
# Optional — only needed for WalletConnect-based connectors. Get one at
# https://cloud.walletconnect.com . Not required for the build.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Gasless relayer (SERVER ONLY — do not prefix NEXT_PUBLIC) ----
# OpenZeppelin Relayer "Channels". Submission runs server-side (app/api/relayer/submit);
# the API key is a fee-spending credential and must never reach the browser.
RELAYER_URL=https://channels.openzeppelin.com/testnet
# [REQUIRED in prod] testnet API key at https://channels.openzeppelin.com/testnet/gen
RELAYER_JWT=

# ---- Backend database (SERVER ONLY — do not prefix NEXT_PUBLIC) ----
# Phase 3/7. Postgres for the own-backend store (passkey keyId -> wallet contractId,
# later user profiles/KYC). Supabase: "Connect" -> Connection string.
# DATABASE_URL = Transaction pooler (port 6543) — used by serverless API routes at runtime.
DATABASE_URL=
# DIRECT_URL = direct/session connection (port 5432) — used only to run migrations/DDL.
DIRECT_URL=
# Shared secret guarding the indexer poll route (POST /api/indexer/poll). Any random string.
INDEXER_SECRET=

# ---- Income-mode keeper (SERVER ONLY — do not prefix NEXT_PUBLIC) ----
# Phase 6. Scheduled job that triggers monthly yield payouts for income-mode users via the
# vault's `claim_yield_for` (non-custodial: only pays a user their own earned yield). NOT
# required for the web build. Keep these in a secret manager.
#   KEEPER_SECRET        — shared secret guarding POST /api/keeper/run (any random string).
#   KEEPER_SIGNER_SECRET — the vault's KEEPER account secret (S…). Generate + fund it, then
#                          designate it on-chain:  stellar contract invoke --id <VAULT> ... --
#                            set_keeper --keeper <its G… address>
#   KEEPER_MIN_CLAIM_USD — skip payouts below this (dust guard). Default 0.01.
KEEPER_SECRET=
KEEPER_SIGNER_SECRET=
KEEPER_MIN_CLAIM_USD=0.01
# Server-side incident kill switch (runtime; NOT NEXT_PUBLIC). "true" halts the keeper's
# autonomous payouts without a redeploy. Independent of the client NEXT_PUBLIC_KILL_SWITCH.
KOVA_KILL_SWITCH=false

# Funding test wallets is MANUAL: send test USDC to the wallet's receive address (shown in the
# app on the Receive screen). Get testnet USDC from Circle's faucet (https://faucet.circle.com).
